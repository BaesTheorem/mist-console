<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mist.routine.auto-commit-harness</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/alexhedtke/Documents/mist-console/run-routine.sh</string>
		<string>auto-commit-harness</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Documents/mist-console/routine-runs.log</string>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Documents/mist-console/routine-runs.log</string>
	<!-- 23:30 local — moved off 22:00 so it no longer races evening-winddown's own
	     git commit+push (both hit the harness repo → non-fast-forward failures).
	     Now runs after winddown finishes, as a true end-of-day safety-net commit. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
