#!/bin/bash
# Restart the detached MIST Console server (the process holding :5014) and
# reopen the app. Needed after app.py/bridge.py/share.py edits: the server is
# init-orphaned, so relaunching the window alone never reloads Python code.
# Chats revive dormant via --resume, so nothing is lost.
#
# Run it DETACHED (launchctl submit, or from a Terminal that isn't a child of a
# Console chat): a Console chat's shell is a descendant of the server, so
# running this inline would kill the very chat that invoked it.
# Go through /bin/bash explicitly: launchd runs the job outside the TCC grant
# that lets a shell read ~/Documents, and only /bin/bash holds Full Disk
# Access here, so a direct submit of this script exits 126 with nothing logged.
#   launchctl remove com.exobrain.mist-console-restart 2>/dev/null
#   launchctl submit -l com.exobrain.mist-console-restart -- /bin/bash "$(cd "$(dirname "$0")" && pwd)/restart-server"
# `launchctl submit` jobs are keep-alive: launchd re-runs the command every
# time it exits, so a submitted restart would kill the server again every
# ~100s forever (that was the 2026-09-17 "Console keeps restarting" bug). The
# script therefore removes its own job as its last step, and refuses to run
# twice within a few minutes as a backstop.
set -u
guard=/tmp/mist-console-restart.last
if [ -f "$guard" ] && [ -n "$(find "$guard" -mmin -3 2>/dev/null)" ]; then
  echo "restart-server: ran within the last 3 min, refusing to loop" >&2
  [ -n "${XPC_SERVICE_NAME:-}" ] && exec launchctl remove "$XPC_SERVICE_NAME"
  exit 0
fi
touch "$guard"
sleep 2   # let the invoking chat finish its turn/response first
pids=$(lsof -tiTCP:5014 -sTCP:LISTEN)
[ -n "$pids" ] && kill $pids
for _ in $(seq 1 20); do
  lsof -tiTCP:5014 -sTCP:LISTEN >/dev/null 2>&1 || break
  sleep 0.5
done
# The window process (desktop.py) is separate and may still be running; a plain
# `open` raise-acks it without a server. Quit it first so reopen boots fresh.
osascript -e 'tell application "MIST Console" to quit' >/dev/null 2>&1
sleep 1
open -a "MIST Console"
# Last step: drop the keep-alive launchd job that ran us, or launchd re-runs
# this script as soon as it exits. exec so no shell is left for launchd to kill.
[ -n "${XPC_SERVICE_NAME:-}" ] && exec launchctl remove "$XPC_SERVICE_NAME"
exit 0
