#!/usr/bin/env python3
"""Boot the live Console page in a headless WebKit and fail on any JavaScript error.

    bin/console-smoke              # against http://127.0.0.1:5014
    bin/console-smoke http://...   # another origin

Catches a broken app.js before a reload of the real window does. Playwright's
WebKit build must be installed once: `python3 -m playwright install webkit`.
Prints a few facts about the booted page (tabs, crystal slot, wallpaper) so a
regression in those shows up too. Exit 1 on a page error or console error.
"""
import sys
import time

from playwright.sync_api import sync_playwright

origin = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:5014"
errors, console = [], []
with sync_playwright() as p:
    browser = p.webkit.launch(headless=True)
    page = browser.new_page(viewport={"width": 1200, "height": 800})
    page.on("pageerror", lambda e: errors.append(str(e)))
    page.on("console", lambda m: console.append(m.text) if m.type == "error" else None)
    page.goto(origin + "/", wait_until="domcontentloaded", timeout=20000)
    time.sleep(6)
    facts = page.evaluate("""() => ({
        tabs: document.querySelectorAll('.tab').length,
        crystalSlot: !!document.getElementById('crystalSlot'),
        headerClips: document.querySelectorAll('#crystalSlot img').length,
        wallpaper: !!document.getElementById('wallSlot'),
        activeLog: !!document.querySelector('.session-log:not([hidden])'),
    })""")
    browser.close()
print("page:", facts)
if errors or console:
    print("page errors:", errors)
    print("console errors:", console)
    sys.exit(1)
print("no JavaScript errors")
